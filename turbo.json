{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalDependencies": ["tsconfig.base.json", "scripts/test.mjs"],
  "tasks": {
    "@packages/ui#build": {
      "outputs": []
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "env": ["NODE_ENV", "VITE_*"]
    },
    "check": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": ["CORNER_TEST_DATABASE_URL"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["CORNER_ORIGIN", "CORNER_DEV_API_PORT"]
    },
    "server#dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "CORNER_*",
        "BETTER_AUTH_SECRET",
        "DATABASE_URL",
        "NEON_AUTH_*",
        "NODE_EXTRA_CA_CERTS"
      ]
    },
    "@packages/shared#dev": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    }
  }
}
