{$CORNER_DOMAIN}, app.{$CORNER_DOMAIN}, docs.{$CORNER_DOMAIN} {
  header Strict-Transport-Security "max-age=31536000"
  reverse_proxy corner:3000 {
    header_up -X-Corner-Client-IP
    header_up X-Corner-Proxy-Token {env.CORNER_PROXY_SECRET}
    header_up X-Corner-Proxy-IP {http.request.remote.host}
  }
}
