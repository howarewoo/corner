{
  "name": "corner",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Independent nutrition and training planning, organized as a Turborepo.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/howarewoo/corner.git"
  },
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:local": "node scripts/local-dev.mjs up",
    "dev:local:seed": "node scripts/local-dev.mjs seed",
    "dev:local:down": "node scripts/local-dev.mjs down",
    "dev:local:reset": "node scripts/local-dev.mjs reset",
    "build": "turbo run build",
    "check": "turbo run check",
    "lint": "oxlint .",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "test": "turbo run test",
    "verify": "node scripts/verify.mjs",
    "test:ci": "node --test scripts/__tests__/*.test.mjs",
    "ci:configure": "node scripts/ci-configure.mjs",
    "release:package": "node scripts/release-artifact.mjs package",
    "release:verify": "node scripts/release-artifact.mjs verify",
    "release:qualify": "node scripts/release-artifact.mjs qualify",
    "release": "node scripts/release.mjs",
    "start": "pnpm --filter server start",
    "db:migrate": "node --env-file-if-exists=.env.local --env-file-if-exists=.env apps/server/dist/migrate.js --apply",
    "db:baseline:staging": "node apps/server/dist/staging-baseline.js --apply",
    "smoke": "node scripts/smoke.mjs",
    "package": "python3 scripts/package.py",
    "smoke:dev": "node scripts/dev-smoke.mjs",
    "build:workers": "pnpm run build && pnpm --filter server exec wrangler deploy --dry-run --outdir dist/worker && pnpm --filter server exec wrangler deploy --config ../web/wrangler.jsonc --dry-run --outdir .wrangler/worker",
    "build:web:worker": "pnpm run build --filter=web && pnpm --filter server exec wrangler deploy --config ../web/wrangler.jsonc --dry-run --outdir .wrangler/worker",
    "smoke:workers": "node scripts/workers-smoke.mjs --frontend-config apps/web/wrangler.jsonc"
  },
  "devDependencies": {
    "@shadcn/lint": "0.2.3",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "turbo": "2.11.10"
  },
  "dependencies": {
    "@neon/config": "^1.9.3",
    "@neon/env": "^1.6.4"
  }
}
