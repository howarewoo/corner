{
  "name": "@corner/server",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --watch --watch-preserve-output --import tsx src/index.ts --dev",
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "node ../../scripts/test.mjs",
    "start": "node --env-file-if-exists=../../.env dist/index.js"
  },
  "dependencies": {
    "@corner/shared": "*",
    "better-auth": "1.7.12",
    "jose": "6.2.13",
    "zod": "3.25.76",
    "zod-to-json-schema": "3.25.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "tsx": "4.22.1",
    "typescript": "5.9.3"
  }
}
