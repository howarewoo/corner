{
  "name": "server",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "node --watch --watch-preserve-output --import tsx src/index.ts --dev",
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "node ../../scripts/test.mjs",
    "start": "node --env-file-if-exists=../../.env.local --env-file-if-exists=../../.env dist/index.js"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.2.0",
    "@orpc/client": "1.16.1",
    "@orpc/server": "1.16.1",
    "@orpc/standard-server-fetch": "1.16.1",
    "@packages/api": "workspace:*",
    "@packages/nutrition": "workspace:*",
    "@packages/training": "workspace:*",
    "@packages/workspace": "workspace:*",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.13",
    "pg": "^8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "^8.23.1",
    "better-auth": "^1.7.12",
    "drizzle-kit": "0.31.11",
    "tsx": "4.22.1",
    "typescript": "5.9.3",
    "undici": "8.12.3",
    "wrangler": "4.153.0"
  }
}
