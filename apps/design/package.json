{
  "name": "design",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "storybook dev --host 127.0.0.1 --port ${CORNER_DESIGN_PORT:-3002} --exact-port --ci --no-version-updates --disable-telemetry",
