# Development: pnpm run dev, then explicitly pnpm run dev:seed.
# Development ignores this file and never connects to cloud Neon or seeds staging/production.
# These settings are only for compiled production and explicit deployment/migration operations.
# neon deploy pulls them into .env.local (or existing .env); never commit real URLs.
# pnpm start loads both: .env overrides .env.local; process env wins.
DATABASE_URL=postgresql://user:password@your-endpoint-pooler.neon.tech/neondb?sslmode=verify-full
DATABASE_URL_UNPOOLED=postgresql://user:password@your-endpoint.neon.tech/neondb?sslmode=verify-full
NEON_AUTH_BASE_URL=https://your-auth-endpoint.neon.tech/neondb/auth
# Also pulled by Neon, but not needed by this cookie/session-based server:
# NEON_AUTH_JWKS_URL=https://your-auth-endpoint.neon.tech/neondb/auth/.well-known/jwks.json
# Never use staging/production credentials for development; pnpm dev ignores these values.

CORNER_DEPLOYMENT=local
CORNER_ORIGIN=http://127.0.0.1:3000
CORNER_LANDING_ORIGIN=http://localhost:3000
CORNER_HOST=127.0.0.1
CORNER_PORT=3000
# Development uses app 127.0.0.1:3000, API 3001, catalog 3002, landing localhost:3003.
CORNER_DEV_API_PORT=3001
CORNER_DATA_DIR=./data
# Must match Neon's email/password policy. The linked branch currently has
# verification OFF. Production Workers and Hosted Compose require it ON ("true")
# with method OTP; Access-gated synthetic staging Preview requires it OFF ("false")
# in both CORNER_STAGING_CONFIG_JSON and its independent staging Neon Auth branch.
NEON_AUTH_REQUIRE_EMAIL_VERIFICATION=false

# Register CORNER_ORIGIN in Neon Auth trusted domains before signing up.
# Configure SMTP and verification codes in Neon, not in Corner. Production
# requires your own SMTP provider; the shared provider is for development.

# The current app requires no model encryption/session-binding secrets.
# Preserve original private configuration and keys with historical backups;
# retirement does not authorize deleting or rotating them.
# CORNER_PROXY_SECRET=<independent-at-least-32-character-proxy-proof>

# Tests/smokes NEVER use DATABASE_URL. Point this only at disposable Postgres:
# CORNER_TEST_DATABASE_URL=postgresql://postgres:corner-test-only@127.0.0.1:45432/corner_test
# Hosted mode requires HTTPS and still disables self-serve ChatGPT registration.
# Workers do not load this file. Configure both public origins and verification in
# the approved production/staging JSON; upload only pooled DB and Auth URL secrets.
# See HOSTING.md#cloudflare-workers. Do not upload the direct migration URL.
