# Copy to .env only if you want to change the local defaults.
CORNER_DEPLOYMENT=local
CORNER_ORIGIN=http://127.0.0.1:3000
CORNER_HOST=127.0.0.1
CORNER_PORT=3000
# Development has a separate API listener; CORNER_ORIGIN remains the web URL.
# CORNER_PORT applies to production. Development uses this API port instead:
CORNER_DEV_API_PORT=3001
CORNER_DATA_DIR=./data
# Relative paths above resolve from the repository root in every workspace.

# Local mode creates stable private keys automatically in the data directory.
# Back up that directory. Never commit it or expose it as static files.
# For a hosted installation, supply independent random values for BOTH keys:
# BETTER_AUTH_SECRET=<at-least-32-random-characters>
# CORNER_TOKEN_ENCRYPTION_KEY=<base64-encoded-32-random-bytes>
# Hosted mode also REQUIRES account email through Resend. Verify your sender
# domain in Resend first and use a sending API key, kept only on the server.
# RESEND_API_KEY=re_<your-sending-api-key>
# CORNER_EMAIL_FROM=Corner <accounts@your-verified-domain.example>
# Set BOTH mail variables or neither. They are optional in local mode; enabling
# them requires email verification and enables password reset in either mode.
# Local mode without mail can sign up/sign in, but cannot send recovery emails.
# Optional: set the same independent random secret on Corner and its trusted
# reverse proxy before forwarding client IPs for account rate limiting.
# Forwarding headers are ignored without a valid proof from that proxy.
# CORNER_PROXY_SECRET=<at-least-32-random-characters>
# Hosted mode requires an HTTPS origin and intentionally disables self-serve
# ChatGPT subscription registration until an approved hosted integration exists.

